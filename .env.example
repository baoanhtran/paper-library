# Copy this file to .env (same folder) and fill in your values. Never commit .env.
# Relative paths are resolved from the repository root.

# Google Drive-synced folders (demo machine: Google Drive for Desktop, seen from WSL2)
PAPERS_DIR="/mnt/c/Users/<you>/My Drive/ResearchLibrary/papers"
OUTPUT_HTML="/mnt/c/Users/<you>/My Drive/ResearchLibrary/output/index.html"

# Local files, outside the synced folder
DB_PATH=data/papers.db
MARKDOWN_DIR=data/markdown

# Local LLM, OpenAI-compatible endpoint (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# Discord webhook URL (secret)
DISCORD_WEBHOOK_URL=
